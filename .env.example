# Copy to .env (never commit .env). Everything here is PUBLIC: values with
# the EXPO_PUBLIC_ prefix are compiled into the app bundle, so never put a
# secret in this file.

# Backend base URL, no trailing slash. India production:
EXPO_PUBLIC_API_URL=https://linknsmile.com

# Razorpay KEY ID (the public "rzp_live_..." / "rzp_test_..." id, NOT the key
# secret). Must belong to the same Razorpay account/mode as the backend above.
EXPO_PUBLIC_RAZORPAY_KEY_ID=

# Sentry DSN for crash reporting. Leave empty to disable Sentry.
EXPO_PUBLIC_SENTRY_DSN=
